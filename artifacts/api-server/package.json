{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "backfill": "tsx src/scripts/backfillHistoricalMatches.ts",
    "test:leakage": "tsx --test src/services/historicalData/leakage.test.ts",
    "test:predictionEngine": "tsx --test src/services/predictionEngine/serveReturn.test.ts src/services/predictionEngine/availability.test.ts src/services/predictionEngine/calibration.test.ts src/services/predictionEngine/playerProfileWarnings.test.ts src/routes/predictions.legacyEngine.test.ts src/services/predictionEngine/simulator.test.ts",
    "test:tennisData": "tsx --test src/services/tennisData/surfaceMap.test.ts src/services/tennisData/playerIdentity.test.ts",
    "test:evaluation": "tsx --test src/services/evaluation/walkForward.test.ts src/services/evaluation/paperTrading.test.ts src/services/evaluation/specialistWeights.test.ts",
    "test:job-smoke": "pnpm run build && tsx --test src/jobs/runPaperTradingJob.smoke.test.ts src/jobs/runCalibrationRefitJob.smoke.test.ts",
    "job:paper-trading": "node --enable-source-maps ./dist/jobs/runPaperTradingJob.mjs",
    "job:paper-trading:dev": "tsx src/jobs/runPaperTradingJob.ts",
    "job:calibration-refit": "node --enable-source-maps ./dist/jobs/runCalibrationRefitJob.mjs",
    "job:calibration-refit:dev": "tsx src/jobs/runCalibrationRefitJob.ts"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
